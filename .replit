modules = ["cpp", "nodejs-20"]
run = "node main.js"

[nix]
channel = "stable-24_05"
packages = ["gcc", "gmp", "fftw", "pkg-config", "gcc13", "cmake", "binutils", "gdb", "valgrind", "python3"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build and Run Mersenne Prime Calculator"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mersenne_build_and_test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "C++ Build and Deploy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Production Start"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Production Deploy"

[[workflows.workflow]]
name = "Build and Run Mersenne Prime Calculator"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sudo apt-get update && sudo apt-get install -y build-essential libgmp-dev libfftw3-dev libomp-dev pkg-config && make clean && make all && ./bin/mersenne_prime -p 127 -v"

[[workflows.workflow]]
name = "mersenne_build_and_test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /tmp && make install-deps && make all && ./bin/mersenne_prime -p 127 -v"

[[workflows.workflow]]
name = "C++ Build and Deploy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./deploy-cpp.sh"

[[workflows.workflow]]
name = "Production Start"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./production-start.sh"
waitForPort = 5000

[[workflows.workflow]]
name = "Production Deploy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[deployment]
deploymentTarget = "cloudrun"
